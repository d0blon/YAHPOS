{/* Siempre dentro de sección con relative overflow-hidden */}
<div className="absolute top-0 right-0 w-[600px] h-[600px] bg-corporate-blue/5 rounded-full blur-[120px] -translate-y-1/2 translate-x-1/3 pointer-events-none" />
