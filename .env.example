# PatagoniaPOS - Environment Variables

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Security
# Salt used for PIN hashing and other internal security
SECURITY_SALT=patagonia-default-salt-change-me

# HMAC secret for developer console cookies (required in production)
DEV_TOKEN_SECRET=change-me-to-a-long-random-value

# Upstash Redis — required in production for rate limiting (fail-closed)
UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# Support & Contact
# Format: 569XXXXXXXX
SUPPORT_WHATSAPP=56912345678
# Correo público de soporte usado por footer,upgrade y editor. Sin valor activo por defecto.
# NEXT_PUBLIC_SUPPORT_EMAIL=

# Root origin compartido por login SSO y /api/auth/sso (HTTP o HTTPS, sin path/query/hash).
# Obligatoria en todos los entornos: si falta o es inválida, el flujo SSO falla cerrado.
# Formato: <scheme>://<host>[:<puerto>] — sin path, query ni hash.
NEXT_PUBLIC_ROOT_ORIGIN=

# Host CNAME destino del root (sin scheme ni puerto) para resolución de tenant por dominio.
# Ejemplo (NO activar valor por defecto):
# NEXT_PUBLIC_ROOT_DOMAIN=root.example.test

# Payment gateways (Flow, Transbank/Webpay, Blumi)
# NO poner credenciales aquí. Cada tienda guarda las suyas cifradas (AES-256-GCM)
# en la tabla `settings`, con service role y SII_ENCRYPTION_KEY:
#   payment_flow_api_key, payment_flow_api_secret,
#   payment_webpay_commerce_code, payment_webpay_api_key, payment_blumi_api_key
# Las llaves antiguas FLOW_API_KEY, FLOW_SECRET, TRANSBANK_COMMERCE_CODE,
# TRANSBANK_API_KEY y BLUMI_API_KEY ya no se leen del entorno.
FLOW_SANDBOX=true
# Obligatoria en producción para el cliente Blumi (fail-closed si falta)
BLUMI_SANDBOX_URL=https://dte.blumi.cl/api/v1/sandbox

# SII Integration
SII_API_URL=https://api.sii.cl
SII_ENVIRONMENT=certification
# AES-256-GCM key for CAF/certificate encryption — EXACTLY 32 characters (required in production)
SII_ENCRYPTION_KEY=change-me-to-a-32-character-value
